// Hermes Agent set up for attack on a host you monitor: yolo mode, jailbreak skill, red-team persona, attack tools
// AOF attack detections by ThreatDefence (Hermes Agent). Source: https://github.com/ThreatDefence/AOF_attack_detections
// Example hunt for Defender XDR advanced hunting. Test and baseline before alerting.
// Hermes Agent (NousResearch/hermes-agent) is a legitimate general-purpose agent, so its presence is not the finding.
// Attackers change it in ways ordinary users rarely do:
//  - Approvals off: hermes --yolo, HERMES_YOLO_MODE, or approvals.mode: off in ~/.hermes/config.yaml. Hunt.io's operator
//    ran it unattended this way inside Thailand's Ministry of Finance network (LinPEAS, SUID search, web root search).
//  - The bundled godmode jailbreak skill (optional-skills/security/godmode): ~/.hermes/skills/security/godmode/scripts/
//    load_godmode.py, auto_jailbreak.py, parseltongue.py, and ~/.hermes/prefill.json with prefill_messages_file set and
//    agent.system_prompt replaced in config.yaml. Unit 42's knaithe/KnYuan actor ran Hermes on DeepSeek with godmode.
//  - A replaced SOUL.md persona: "SOUL - Red Team Operator" (Gambit) or the GH0ST persona Carbonato writes to
//    /root/.hermes/SOUL.md, with loot kept in /root/.hermes/loot/. File events show the write; YARA reads the text.
//  - Attack tools started under Hermes, and python3 -m http.server started from the agent's home folder (Unit 42).

let Window = 30d;
let AttackTools = dynamic(["nmap", "masscan", "naabu", "nuclei", "sqlmap", "ffuf", "gobuster", "hydra", "netexec", "nxc", "kerbrute",
    "linpeas.sh", "msfconsole", "chisel", "frp", "frpc", "socat", "ncat", "nc", "suo5"]);
let HermesProc = @"(^|[/\\\s])hermes(\.exe)?(\s|$)|hermes_cli|run_agent\.py|/\.hermes/|hermes-agent";
union isfuzzy=true
    (DeviceProcessEvents
        | where Timestamp > ago(Window)
        | where ProcessCommandLine matches regex HermesProc
            and (ProcessCommandLine contains "--yolo" or ProcessCommandLine contains "HERMES_YOLO_MODE" or ProcessCommandLine contains "approvals.mode")
        | project Timestamp, DeviceName, Signal="Hermes with approvals off", Detail=substring(ProcessCommandLine, 0, 300), Account=AccountName),
    (DeviceProcessEvents
        | where Timestamp > ago(Window)
        | where ProcessCommandLine matches regex @"(load_godmode|auto_jailbreak|parseltongue|godmode_race)\.py"
        | project Timestamp, DeviceName, Signal="Hermes godmode jailbreak skill ran", Detail=substring(ProcessCommandLine, 0, 300), Account=AccountName),
    (DeviceProcessEvents
        | where Timestamp > ago(Window)
        | where InitiatingProcessCommandLine matches regex HermesProc or InitiatingProcessParentFileName =~ "hermes"
        | where tolower(FileName) in (AttackTools) or ProcessCommandLine matches regex @"linpeas|pspy|http\.server|hive_rce|suo5"
        | summarize Tools=make_set(FileName, 20), Commands=make_set(substring(ProcessCommandLine, 0, 200), 15), Timestamp=min(Timestamp)
            by DeviceName, Account=AccountName
        | project Timestamp, DeviceName, Signal="Attack tools or a file server under Hermes", Detail=strcat(tostring(Tools), " ", tostring(Commands)), Account),
    (DeviceFileEvents
        | where Timestamp > ago(Window)
        | where FolderPath matches regex @"[/\\]\.hermes[/\\]"
        | where (FileName =~ "SOUL.md" and ActionType in ("FileCreated", "FileModified"))
            or FileName =~ "prefill.json"
            or FolderPath matches regex @"[/\\]\.hermes[/\\](loot|skills[/\\]security[/\\]godmode)[/\\]"
        | summarize Files=make_set(FolderPath, 10), Writers=make_set(InitiatingProcessFileName, 5), Timestamp=min(Timestamp) by DeviceName, Account=InitiatingProcessAccountName
        | project Timestamp, DeviceName, Signal="Hermes persona, jailbreak or loot files", Detail=strcat(tostring(Files), " written by ", tostring(Writers)), Account)
| order by Timestamp desc
