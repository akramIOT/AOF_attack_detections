# AOF attack detections by ThreatDefence: behaviors shared by agentic attack frameworks
# https://github.com/ThreatDefence/AOF_attack_detections
# Suricata 7 and 8. Rules keep the SIDs they were first published with.

alert http any any -> $HTTP_SERVERS any (msg:"TD Claude Code WebFetch user agent (AI agent page reader, Cairn workers, also legitimate use)"; flow:established,to_server; http.user_agent; content:"Claude-User (claude-code/"; fast_pattern; classtype:misc-activity; sid:9727010; rev:1; metadata:created_at 2026_11_21, confidence Low, malware_family Cairn;)
