/*
   AOF attack detections by ThreatDefence: HexStrike
   https://github.com/ThreatDefence/AOF_attack_detections

   Experimental. Built from the HexStrike source code, tested against the HexStrike source tree.
*/

rule HexStrike_Server_Or_Client
{
    meta:
        description = "HexStrike tool server or MCP client script, or a fork that keeps its strings"
        author = "ThreatDefence"
        date = "2026-11-21"
        reference = "https://github.com/0x4m4/hexstrike-ai"
        confidence = "high"
    strings:
        $s1 = "HexStrike AI Tools API Server is operational" ascii
        $s2 = "HexStrike-HTTP-Framework/1.0" ascii
        $s3 = "HexStrike-BrowserAgent/1.0" ascii
        $s4 = "hexstrikeXSSTest123" ascii
        $s5 = "hexstrike-ai-mcp" ascii
        $s6 = "DEFAULT_HEXSTRIKE_SERVER" ascii
        $s7 = "/tmp/hexstrike_files" ascii
    condition:
        filesize < 5MB and 2 of them
}

rule HexStrike_MCP_Client_Config
{
    meta:
        description = "MCP client configuration (Claude Desktop, Cursor, VS Code and similar) that wires an assistant to a HexStrike server"
        author = "ThreatDefence"
        date = "2026-11-21"
        reference = "https://github.com/0x4m4/hexstrike-ai"
        confidence = "high"
    strings:
        $m = "mcpServers" ascii
        $h = "hexstrike_mcp.py" ascii
        $p = ":8888" ascii
    condition:
        filesize < 256KB and $m and $h and $p
}

rule HexStrike_Generated_Exploit
{
    meta:
        description = "CVE exploit script generated by HexStrike's exploit generator"
        author = "ThreatDefence"
        date = "2026-11-21"
        reference = "https://github.com/0x4m4/hexstrike-ai"
        confidence = "medium"
    strings:
        $ua = "Mozilla/5.0 (Compatible Exploit)" ascii
        $f = "def exploit_rce(target_url, command)" ascii
    condition:
        filesize < 1MB and all of them
}
