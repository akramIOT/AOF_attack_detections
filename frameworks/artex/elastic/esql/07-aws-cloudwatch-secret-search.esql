// CloudWatch logs searched for secrets (AWS CloudTrail integration)
// ARTEX detections by ThreatDefence. https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// ES|QL hunt using ECS fields. Change the index pattern to match your data streams and baseline before alerting.
FROM logs-aws.cloudtrail-*
| WHERE @timestamp > NOW() - 30 days AND event.provider == "logs.amazonaws.com" AND event.action == "FilterLogEvents"
| WHERE aws.cloudtrail.request_parameters RLIKE "(?i).*(password|AKIA|secret|token|limit=1000).*"
| STATS calls = COUNT(*), params = VALUES(aws.cloudtrail.request_parameters), first_seen = MIN(@timestamp), last_seen = MAX(@timestamp)
    BY aws.cloudtrail.user_identity.arn, source.ip, user_agent.original
| SORT calls DESC
