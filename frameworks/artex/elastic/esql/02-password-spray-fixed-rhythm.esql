// Password spray at a fixed rhythm (Entra ID sign-ins, Filebeat or Elastic Agent Azure integration)
// ARTEX detections by ThreatDefence. https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// ES|QL hunt using ECS fields. Change the index pattern to match your data streams and baseline before alerting.
// ES|QL has no previous-row function, so the rhythm is approximated as attempts per second of activity:
// 200+ failures across 20+ users at one attempt every two seconds or faster, inside an hour.
FROM logs-azure.signinlogs-*
| WHERE @timestamp > NOW() - 30 days AND event.outcome == "failure"
| EVAL hour = DATE_TRUNC(1 hour, @timestamp)
| STATS attempts = COUNT(*), users = COUNT_DISTINCT(azure.signinlogs.properties.user_principal_name),
    first_seen = MIN(@timestamp), last_seen = MAX(@timestamp)
    BY source.ip, user_agent.original, hour
| EVAL span_sec = DATE_DIFF("second", first_seen, last_seen), rate = attempts / GREATEST(span_sec, 1)
| WHERE attempts >= 200 AND users >= 20 AND rate >= 0.5
| SORT attempts DESC
