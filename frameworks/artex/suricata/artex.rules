# ARTEX detections by ThreatDefence
# https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
# Suricata 7 and 8. SID range 9726001-9726199. Indicator-based IP rules live in artex-ip.rules (generated).
# HTTP rules need cleartext HTTP or TLS decryption. TLS SNI and DNS rules work on encrypted traffic.

# --- User agents that name ARTEX (requests in either direction: inbound attacks or a host running ARTEX) ---
alert http any any -> any any (msg:"TD ARTEX user agent artex-<role>/1.0"; flow:established,to_server; http.user_agent; content:"artex-"; nocase; fast_pattern; pcre:"/artex-(readonly|pentest|audit|verify|spawn|enrich)\//i"; classtype:web-application-attack; sid:9726001; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent ARTEX-worker"; flow:established,to_server; http.user_agent; content:"ARTEX-worker/"; fast_pattern; classtype:web-application-attack; sid:9726002; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent ARTeX"; flow:established,to_server; http.user_agent; content:"ARTeX"; fast_pattern; classtype:web-application-attack; sid:9726003; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent canary"; flow:established,to_server; http.user_agent; content:"artex-i21861-canary"; fast_pattern; classtype:web-application-attack; sid:9726004; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent Mozilla/5.0 (ARTEX)"; flow:established,to_server; http.user_agent; content:"Mozilla/5.0 (ARTEX)"; fast_pattern; classtype:web-application-attack; sid:9726005; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent ArtEx variant"; flow:established,to_server; http.user_agent; content:"ArtEx"; fast_pattern; pcre:"/ArtEx(Verify)?\/1\.0/"; classtype:web-application-attack; sid:9726006; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX ScopeWeaver renamed build user agent"; flow:established,to_server; http.user_agent; content:"scopeweaver"; nocase; fast_pattern; classtype:web-application-attack; sid:9726007; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX spa-api-recon user agent"; flow:established,to_server; http.user_agent; content:"spa-api-recon"; fast_pattern; classtype:web-application-attack; sid:9726008; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)

# --- Probe artifacts in requests ---
alert http any any -> $HTTP_SERVERS any (msg:"TD ARTEX placeholder probe path"; flow:established,to_server; http.uri; content:"zzz-nonexistent-xyz123"; fast_pattern; classtype:web-application-attack; sid:9726020; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX placeholder object name in S3 or storage probe"; flow:established,to_server; http.uri; content:"zzz_nonexistent_abc.txt"; fast_pattern; classtype:web-application-attack; sid:9726021; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> $HTTP_SERVERS any (msg:"TD ARTEX OAuth callback probe"; flow:established,to_server; http.uri; content:"code=AAAA&state=notvalidb64!!"; fast_pattern; classtype:web-application-attack; sid:9726022; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Unsigned alg none JWT in URI"; flow:established,to_server; http.uri; content:"eyJhbGciOiJub25lIn0."; fast_pattern; classtype:web-application-attack; sid:9726023; rev:1; metadata:created_at 2026_11_20, confidence Medium;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Unsigned alg none JWT in Authorization header"; flow:established,to_server; http.header; content:"Authorization|3a| "; nocase; content:"eyJhbGciOiJub25lIn0."; distance:0; fast_pattern; classtype:web-application-attack; sid:9726024; rev:1; metadata:created_at 2026_11_20, confidence Medium;)
alert http any any -> any any (msg:"TD ARTEX X-ARTX-KEY request header"; flow:established,to_server; http.header_names; content:"|0d 0a|X-ARTX-KEY|0d 0a|"; nocase; fast_pattern; classtype:web-application-attack; sid:9726025; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX probe marker in request"; flow:established,to_server; http.uri; content:"ARTEX"; nocase; fast_pattern; pcre:"/(ARTEX_WRITE_PROBE|ARTX_PERSIST_OK|artex_control_marker_zz9q|ARTEX-PROBE-|artex-probe-)/i"; classtype:web-application-attack; sid:9726026; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)

# --- ARTEX consoles (attack surface checks and hosts on your network running ARTEX) ---
alert http any any -> any any (msg:"TD ARTEX console page served"; flow:established,to_client; http.response_body; content:"<title>ARTEX"; fast_pattern; content:"_next/static"; classtype:policy-violation; sid:9726040; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX renamed console page served (ScopeWeaver or LUCK)"; flow:established,to_client; http.response_body; content:"<title>"; pcre:"/<title>(ScopeWeaver|LUCK)[ :\-<]/"; content:"_next/static"; classtype:policy-violation; sid:9726041; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX Basic auth realm"; flow:established,to_client; http.header; content:"realm=|22|ARTEX|22|"; nocase; fast_pattern; classtype:policy-violation; sid:9726042; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)

# --- Command and control and callback infrastructure (DNS and TLS, works on encrypted traffic) ---
alert dns any any -> any any (msg:"TD VAPOR PANDA BLOODALCHEMY C2 domain lookup (ARTEX campaign)"; dns.query; pcre:"/^(nginxmysql\.com|sqlserver-sqlite\.com|www\.ddduuuppp\.com)$/i"; classtype:trojan-activity; sid:9726060; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family BLOODALCHEMY;)
alert tls any any -> any any (msg:"TD VAPOR PANDA BLOODALCHEMY C2 domain in TLS SNI (ARTEX campaign)"; flow:established,to_server; tls.sni; pcre:"/^(nginxmysql\.com|sqlserver-sqlite\.com|www\.ddduuuppp\.com)$/i"; classtype:trojan-activity; sid:9726061; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family BLOODALCHEMY;)
alert dns $HOME_NET any -> any any (msg:"TD Request collection service lookup from a server (webhook.site)"; dns.query; dotprefix; content:".webhook.site"; endswith; fast_pattern; classtype:policy-violation; sid:9726062; rev:1; metadata:created_at 2026_11_20, confidence Low;)
alert dns $HOME_NET any -> any any (msg:"TD DNS callback service lookup with artx label (dnslog.cn)"; dns.query; content:"artx"; nocase; content:".dnslog.cn"; endswith; fast_pattern; classtype:trojan-activity; sid:9726063; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)
alert dns $HOME_NET any -> any any (msg:"TD Community-reported ARTEX infrastructure domain lookup"; dns.query; pcre:"/(^|\.)(artex\.lol|artex\.tokena2b\.top|artex\.ok7777\.eu\.cc|artex\.noog2infra\.site)$/i"; classtype:trojan-activity; sid:9726064; rev:1; metadata:created_at 2026_11_20, confidence Low, malware_family ARTEX;)

# --- Payload hosts active in ARTEX operator toolkits (ThreatDefence, November 20, 2026; vietnam852 also reported by Fortinet) ---
alert dns $HOME_NET any -> any any (msg:"TD ARTEX toolkit payload host lookup (vietnam852.com, zhzy999.net, jiancai008.com)"; dns.query; pcre:"/(^|\.)(vietnam852\.com|zhzy999\.net|jiancai008\.com)$/i"; classtype:trojan-activity; sid:9726065; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family Gh0stRAT;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD ARTEX toolkit payload download from vietnam852, zhzy999 or jiancai008"; flow:established,to_server; http.host; pcre:"/(^|\.)(vietnam852\.com|zhzy999\.net|jiancai008\.com)(:\d+)?$/i"; classtype:trojan-activity; sid:9726066; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family Gh0stRAT;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Fake Windows system binary or miner driver downloaded from a /test/ path"; flow:established,to_server; http.uri; content:"/test/"; fast_pattern; pcre:"/\/test\/(smss\.exe|winlogon\.exe|WinRing0x64\.sys|MicrosoftEdgeUpdate\.exe|dllhost\.exe|sihost\.exe)$/i"; classtype:trojan-activity; sid:9726067; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family Gh0stRAT;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 8000 (msg:"TD Gh0st RAT C2 server.vietnam852.com on port 8000"; flow:established,to_server; content:"server.vietnam852.com"; nocase; classtype:trojan-activity; sid:9726068; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family Gh0stRAT;)
