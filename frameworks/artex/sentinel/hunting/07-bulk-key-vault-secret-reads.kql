// Bulk Key Vault secret reads
// ARTEX detections by ThreatDefence. Source: https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// Example hunt for Microsoft Sentinel and Defender XDR advanced hunting. Test and baseline before alerting.

// Example: one identity reading many secrets across several vaults in 15 minutes
AzureDiagnostics
| where TimeGenerated >= datetime(2026-08-01)
| where ResourceProvider == "MICROSOFT.KEYVAULT" and OperationName == "SecretGet"
| summarize SecretGets=count(), Vaults=dcount(Resource), IPs=make_set(CallerIPAddress, 10)
    by identity_claim_appid_g, bin(TimeGenerated, 15m)
| where SecretGets >= 20 and Vaults >= 3
| order by SecretGets desc
