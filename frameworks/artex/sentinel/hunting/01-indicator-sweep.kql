// Indicator sweep
// ARTEX detections by ThreatDefence. Source: https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// Example hunt for Microsoft Sentinel and Defender XDR advanced hunting. Test and baseline before alerting.
// Search every log source that records a user agent or a source address.

// Example: ARTEX user agents and published addresses across identity, Graph, AWS and web logs
let ArtexIPs = dynamic(["144.172.64.128","144.172.64.99","144.172.64.60","104.194.150.21","167.88.172.97",
    "154.64.252.77","154.36.136.197","154.36.136.23","103.54.154.40","103.54.154.32","169.128.55.214",
    "82.158.88.233","45.145.228.25","102.216.154.102","88.229.22.232","38.244.50.120","101.53.80.20",
    "205.214.59.31","124.155.252.63","154.201.79.246","23.248.249.90","23.158.220.98","103.248.148.84",
    "203.160.133.172","209.209.85.38","199.19.95.66","199.19.95.67","199.19.95.68","91.92.240.238","85.11.168.45",
    "178.16.54.129","31.77.229.35","85.11.167.52","45.153.126.223","89.46.234.50","192.121.47.20",
    // Cisco Talos, ReversingLabs and ThreatDefence, November 2026
    "50.236.159.26","203.160.86.12","104.192.80.202","102.220.160.54","102.220.160.56","102.220.160.65",
    "103.27.108.213","103.72.98.156","109.123.250.22","132.243.238.34","141.147.178.203","15.235.160.67",
    "154.12.61.65","154.26.214.22","154.26.214.75","156.240.236.18","158.220.83.23","162.217.248.165",
    "168.138.192.210","177.74.185.216","185.19.40.39","185.38.142.63","192.241.102.190","2.56.127.146",
    "202.61.160.141","202.61.160.143","202.61.160.146","204.194.50.136","204.194.54.78","207.180.249.248",
    "209.38.44.23","217.76.54.42","31.56.209.81","36.50.135.20","64.90.7.157","77.42.39.177",
    "8.217.226.218","83.229.121.12","85.189.58.207","89.117.145.158","95.133.168.226",
    "92.255.57.0/24"]);
union isfuzzy=true
    (SigninLogs | project TimeGenerated, Source="EntraSignIn", Agent=UserAgent, IP=IPAddress, Detail=UserPrincipalName),
    (AADNonInteractiveUserSignInLogs | project TimeGenerated, Source="EntraNonInteractive", Agent=UserAgent, IP=IPAddress, Detail=UserPrincipalName),
    (MicrosoftGraphActivityLogs | project TimeGenerated, Source="Graph", Agent=UserAgent, IP=IPAddress, Detail=RequestUri),
    (AWSCloudTrail | project TimeGenerated, Source="CloudTrail", Agent=UserAgent, IP=SourceIpAddress, Detail=EventName),
    (CommonSecurityLog | project TimeGenerated, Source="WebOrProxy", Agent=RequestClientApplication, IP=SourceIP, Detail=RequestURL)
| where TimeGenerated >= datetime(2026-08-01)
| where Agent contains "artex" or Agent has "ReconProbe" or Agent startswith "norma/" or Agent startswith "azure-toolkit/"
    or Agent has "scopeweaver" or Agent has "spa-api-recon"
    or ipv4_is_in_any_range(IP, ArtexIPs)
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Samples=make_set(Detail, 10)
    by Source, Agent, IP
| order by FirstSeen asc
