// A spray that ends in a successful sign-in
// ARTEX detections by ThreatDefence. Source: https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// Example hunt for Microsoft Sentinel and Defender XDR advanced hunting. Test and baseline before alerting.

// Example: a successful sign-in from an address that failed against many users
let Sprayers = union isfuzzy=true SigninLogs, AADNonInteractiveUserSignInLogs
    | where TimeGenerated >= datetime(2026-08-01) and ResultType != "0"
    | summarize Failures=count(), TargetedUsers=dcount(UserPrincipalName) by IPAddress
    | where Failures >= 100 and TargetedUsers >= 20;
union isfuzzy=true SigninLogs, AADNonInteractiveUserSignInLogs
| where TimeGenerated >= datetime(2026-08-01) and ResultType == "0"
| join kind=inner Sprayers on IPAddress
| project TimeGenerated, UserPrincipalName, IPAddress, UserAgent, AppDisplayName, Failures, TargetedUsers
| order by TimeGenerated asc
