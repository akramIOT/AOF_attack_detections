// CloudWatch log searches with a stolen AWS key
// ARTEX detections by ThreatDefence. Source: https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// Example hunt for Microsoft Sentinel and Defender XDR advanced hunting. Test and baseline before alerting.
// Read the search patterns in the result. Company names combined with words like Fund, Invoice, Billing and LLC match what Datadog saw.

// Example: FilterLogEvents with the fixed limit of 1000 or secret-hunting search terms
AWSCloudTrail
| where TimeGenerated >= datetime(2026-08-01)
| where EventName == "FilterLogEvents"
| extend Params = parse_json(RequestParameters)
| extend Limit = toint(Params.limit), Pattern = tostring(Params.filterPattern), LogGroup = tostring(Params.logGroupName)
| where Limit == 1000 or Pattern has_any ("AKIA", "password", "presigned", "mongo") or Pattern has "s3://"
| summarize Calls=count(), LogGroups=dcount(LogGroup), Patterns=make_set(Pattern, 50)
    by UserIdentityArn, UserIdentityAccessKeyId, SourceIpAddress, bin(TimeGenerated, 1h)
| where Calls >= 20
| order by Calls desc
